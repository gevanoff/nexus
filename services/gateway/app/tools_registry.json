{
  "tools": [
    {
      "name": "echo",
      "version": "1",
      "description": "Example tool executed as a subprocess. Reads JSON args on stdin; writes text/JSON to stdout.",
      "parameters": {
        "type": "object",
        "properties": {
          "msg": { "type": "string" }
        },
        "required": ["msg"],
        "additionalProperties": false
      },
      "exec": {
        "type": "subprocess",
        "argv": ["/usr/bin/python3", "-c", "import sys,json; a=json.load(sys.stdin); print(a.get('msg',''))"],
        "timeout_sec": 5,
        "cwd": "/var/lib/gateway/tools"
      }
    },
    {
      "name": "followyourcanvas_generate",
      "version": "1",
      "description": "Generate a video via the FollowYourCanvas backend (POST /v1/videos/generations).",
      "parameters": {
        "type": "object",
        "properties": {
          "prompt": { "type": "string" },
          "duration_seconds": { "type": "integer", "minimum": 1 },
          "width": { "type": "integer", "minimum": 64 },
          "height": { "type": "integer", "minimum": 64 },
          "seed": { "type": "integer" }
        },
        "required": ["prompt"],
        "additionalProperties": true
      },
      "exec": {
        "type": "subprocess",
        "argv": ["/usr/bin/python3", "/var/lib/gateway/tools/followyourcanvas_generate.py"],
        "timeout_sec": 900,
        "cwd": "/var/lib/gateway/tools"
      }
    },
    {
      "name": "ltx_generate",
      "version": "1",
      "description": "Generate high-quality video with LTX-2.3 on ada2.",
      "parameters": {
        "type": "object",
        "properties": {
          "prompt": { "type": "string" },
          "duration_seconds": { "type": "integer", "minimum": 1, "maximum": 10 },
          "resolution": { "type": "string" },
          "fps": { "type": "integer", "minimum": 1, "maximum": 30 },
          "seed": { "type": "integer" }
        },
        "required": ["prompt"],
        "additionalProperties": true
      },
      "exec": {
        "type": "subprocess",
        "argv": ["/usr/bin/python3", "/var/lib/gateway/tools/ltx_generate.py"],
        "timeout_sec": 3600,
        "cwd": "/var/lib/gateway/tools"
      }
    },
    {
      "name": "hunyuan_video_generate",
      "version": "1",
      "description": "Generate text-to-video or image-to-video with HunyuanVideo-1.5 on stackrot.",
      "parameters": {
        "type": "object",
        "properties": {
          "prompt": { "type": "string" },
          "image": { "type": "string" },
          "duration_seconds": { "type": "integer", "minimum": 1, "maximum": 10 },
          "resolution": { "type": "string", "enum": ["480p", "720p"] },
          "aspect_ratio": { "type": "string" },
          "seed": { "type": "integer" }
        },
        "required": ["prompt"],
        "additionalProperties": true
      },
      "exec": {
        "type": "subprocess",
        "argv": ["/usr/bin/python3", "/var/lib/gateway/tools/hunyuan_video_generate.py"],
        "timeout_sec": 3600,
        "cwd": "/var/lib/gateway/tools"
      }
    },
    {
      "name": "ace_step_generate",
      "version": "1",
      "description": "Generate music with ACE-Step 1.5 XL SFT and the 4B language model on stackrot.",
      "parameters": {
        "type": "object",
        "properties": {
          "prompt": { "type": "string" },
          "style": { "type": "string" },
          "lyrics": { "type": "string" },
          "audio_duration": { "type": "integer", "minimum": 10, "maximum": 600 },
          "bpm": { "type": "integer" },
          "keyscale": { "type": "string" },
          "timesignature": { "type": "string" },
          "seed": { "type": "integer" }
        },
        "anyOf": [
          { "required": ["prompt"] },
          { "required": ["style"] },
          { "required": ["lyrics"] }
        ],
        "additionalProperties": true
      },
      "exec": {
        "type": "subprocess",
        "argv": ["/usr/bin/python3", "/var/lib/gateway/tools/ace_step_generate.py"],
        "timeout_sec": 1800,
        "cwd": "/var/lib/gateway/tools"
      }
    },
    {
      "name": "heartmula_generate",
      "version": "1",
      "description": "Generate music via the HeartMula backend (POST /v1/music/generations).",
      "parameters": {
        "type": "object",
        "properties": {
          "prompt": { "type": "string" },
          "input": { "type": "string" },
          "duration": { "type": "number" },
          "temperature": { "type": "number" },
          "top_k": { "type": "integer" },
          "top_p": { "type": "number" }
        },
        "required": [],
        "additionalProperties": true
      },
      "exec": {
        "type": "subprocess",
        "argv": ["/usr/bin/python3", "/var/lib/gateway/tools/heartmula_generate.py"],
        "timeout_sec": 120,
        "cwd": "/var/lib/gateway/tools"
      }
    },
    {
      "name": "lighton_ocr",
      "version": "1",
      "description": "Run OCR via the LightOnOCR shim (POST /v1/ocr).",
      "parameters": {
        "type": "object",
        "properties": {
          "image_url": { "type": "string", "description": "Public image URL to scan." },
          "image_base64": { "type": "string", "description": "Base64 image data (optional)." }
        },
        "required": [],
        "additionalProperties": false
      },
      "exec": {
        "type": "subprocess",
        "argv": ["/usr/bin/python3", "/var/lib/gateway/tools/lighton_ocr_tool.py"],
        "timeout_sec": 120,
        "cwd": "/var/lib/gateway/tools"
      }
    }
  ]
}
