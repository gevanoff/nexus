NEXUS_SERVICE_NAME=hf-nvidia-nvidia-nemotron-nano-9b-v2
NEXUS_SERVICE_TITLE=HF NVIDIA-Nemotron-Nano-9B-v2
NEXUS_SERVICE_DESCRIPTION=HuggingFace model adapter for nvidia/NVIDIA-Nemotron-Nano-9B-v2
NEXUS_SERVICE_VERSION=0.1.0
NEXUS_SERVICE_PORT=8610
NEXUS_SERVICE_BACKEND_CLASS=hf_nvidia_nvidia_nemotron_nano_9b_v2

NEXUS_ROUTE_KIND=chat
NEXUS_MODEL_ID=nvidia/NVIDIA-Nemotron-Nano-9B-v2
NEXUS_MODEL_OWNER=huggingface

# auto: prefer upstream if configured, otherwise local command
# upstream: always proxy NEXUS_UPSTREAM_BASE_URL
# command: always execute NEXUS_RUN_COMMAND
NEXUS_EXECUTION_MODE=command

NEXUS_TIMEOUT_SEC=300
NEXUS_READYZ_TIMEOUT_SEC=10
NEXUS_WORKDIR=/app
NEXUS_SHELL=/bin/sh

NEXUS_UPSTREAM_BASE_URL=
NEXUS_UPSTREAM_ENDPOINT=
NEXUS_UPSTREAM_READY_PATHS=/readyz,/healthz,/health,/v1/models

NEXUS_RUN_COMMAND=python runner/run_model.py
NEXUS_RUN_READY_COMMAND=

NEXUS_OUTPUT_MEDIA_TYPE=
HF_MODEL_ID=nvidia/NVIDIA-Nemotron-Nano-9B-v2
HF_HOME=/var/lib/huggingface
HUGGINGFACE_HUB_TOKEN=
ETCD_URL=http://etcd:2379

DEVICE=cuda
MAX_NEW_TOKENS=2048
TEMPERATURE=0.7
TOP_P=0.9
TOP_K=50
REPEAT_PENALTY=1.0
