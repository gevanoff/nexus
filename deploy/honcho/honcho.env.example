# Copy to deploy/env/.env.prod.honcho on copyfail and chmod 600.
# Keep the populated file out of git.

# Pin the upstream source checkout used as the Docker build context.
HONCHO_SOURCE_DIR=/home/ai/ai/honcho
HONCHO_UPSTREAM_REF=v3.0.12

# Bind to copyfail's private Nexus address, not a public interface.
HONCHO_BIND_ADDRESS=127.0.0.1
HONCHO_PORT=8000
NEXUS_HOST_AI2_IP=

# Generate independent random values; do not reuse a Telegram token.
HONCHO_DB_PASSWORD=
AUTH_USE_AUTH=true
AUTH_JWT_SECRET=

# Use a dedicated restricted Nexus Gateway token when possible.
LLM_OPENAI_API_KEY=

SENTRY_ENABLED=false
TELEMETRY_ENABLED=false
METRICS_ENABLED=true
