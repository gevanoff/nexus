# Example prod host env file
#
# Copy from: ../../.env.example
# Target:   deploy/env/.env.prod
#
# This file should contain secrets and MUST NOT be committed.
# The repo .gitignore ignores deploy/env/.env.prod.

# Required
GATEWAY_BEARER_TOKEN=change-me

# Typical prod settings
GATEWAY_PORT=8800
OBSERVABILITY_PORT=8801

# Required on deployed hosts. Use an explicit absolute path for bind-mounted
# runtime state instead of relying on compose-file-relative fallbacks.
NEXUS_RUNTIME_ROOT=/absolute/path/to/runtime
