{
  "schema_version": 1,
  "settings": {
    "mode": "assisted",
    "poll_interval_sec": 15,
    "request_hot_window_sec": 900,
    "optional_idle_stop_sec": 1800,
    "memory_pressure_used_ratio": 0.9,
    "target_free_vram_mb": 4096,
    "model_probe_enabled": true,
    "llm_advisor": {
      "enabled": true,
      "mode": "decide",
      "model": "fast",
      "base_url": "http://gateway:8800/v1",
      "timeout_sec": 20,
      "max_context_chars": 3000,
      "max_tokens": 768,
      "min_confidence": 0.55,
      "include_models": true
    }
  },
  "tiers": {
    "crucial": {
      "rank": 100,
      "description": "Keep running unless an operator explicitly stops it."
    },
    "high": {
      "rank": 50,
      "description": "Prefer to keep running; can displace optional idle backends."
    },
    "optional": {
      "rank": 10,
      "description": "Can be traded in and out for specialized workflows."
    }
  },
  "hosts": {
    "ai1": {
      "resource_kind": "linux_nvidia",
      "ssh_connect_target": "ai@host.docker.internal",
      "ssh_port": 19022,
      "env_file": "deploy/env/.env.prod.ai1"
    },
    "ai2": {
      "resource_kind": "macos",
      "env_file": "deploy/env/.env.prod.ai2",
      "remote_shell": "/bin/zsh -lic"
    },
    "ada2": {
      "resource_kind": "linux_nvidia",
      "ssh_connect_target": "ai@host.docker.internal",
      "ssh_port": 19023,
      "env_file": "deploy/env/.env.prod.ada2"
    },
    "meltdown": {
      "resource_kind": "linux_nvidia",
      "ssh_connect_target": "ai@host.docker.internal",
      "ssh_port": 19024,
      "env_file": "deploy/env/.env.prod.meltdown"
    },
    "copyfail": {
      "resource_kind": "linux_infra",
      "ssh_connect_target": "ai@host.docker.internal",
      "ssh_port": 19025,
      "env_file": "deploy/env/.env.prod.copyfail"
    },
    "migraine": {
      "platform": "macos",
      "resource_kind": "macos",
      "ssh_target": "ai@migraine",
      "env_file": "deploy/env/.env.prod.migraine",
      "remote_shell": "/bin/zsh -lic"
    },
    "adada": {
      "platform": "linux",
      "resource_kind": "linux_nvidia",
      "ssh_target": "ai@adada",
      "env_file": "deploy/env/.env.prod.adada"
    }
  },
  "core_services": {
    "gateway": {
      "display_name": "Gateway",
      "host": "ai2",
      "component": "gateway",
      "tier": "core",
      "notes": "Primary API, Chat UI, Resources UI, and routing plane."
    },
    "etcd": {
      "display_name": "etcd",
      "host": "ai2",
      "component": "etcd",
      "tier": "core",
      "notes": "Service registry and discovery state for Nexus."
    },
    "lifecycle_manager": {
      "display_name": "Lifecycle Manager",
      "host": "ai2",
      "component": "lifecycle-manager",
      "tier": "core",
      "notes": "Tracks host resources and manages backend lifecycle actions."
    },
    "telegram_bot": {
      "display_name": "Telegram Bot",
      "host": "ai2",
      "component": "telegram-bot",
      "tier": "core",
      "notes": "Telegram bridge into the gateway."
    },
    "deployment_control": {
      "display_name": "Deployment Control",
      "host": "copyfail",
      "components": [],
      "tier": "core",
      "notes": "Infrastructure-only host intended for metrics collection, deployment orchestration, and general IT operations. It is intentionally excluded from model backend placement."
    },
    "hermes_client": {
      "display_name": "Hermes Client",
      "host": "migraine",
      "components": [],
      "tier": "core",
      "notes": "Client-only Hermes and Telegram consumer host. It consumes Nexus models through the gateway and is intentionally excluded from model backend placement."
    },
    "adada_inventory": {
      "display_name": "adada Inventory",
      "host": "adada",
      "components": [],
      "tier": "core",
      "notes": "Lifecycle-visible Linux/NVIDIA inventory host. It is not assigned model-serving backends in the production topology."
    }
  },
  "backends": {
    "local_mlx": {
      "display_name": "MLX",
      "host": "ai2",
      "component": "mlx",
      "tier": "crucial",
      "capabilities": ["chat", "transcription"],
      "estimated_vram_mb": 0,
      "auto_start": false,
      "auto_stop": false,
      "compose_managed": false,
      "ready_path": "/models",
      "canary": {
        "enabled": true,
        "method": "POST",
        "path": "/chat/completions",
        "timeout_sec": 15,
        "failure_threshold": 4,
        "payload": {
          "model": "mlx-community/Phi-4-reasoning-plus-4bit",
          "messages": [
            {
              "role": "user",
              "content": "Reply with the single word OK."
            }
          ],
          "max_tokens": 4,
          "temperature": 0
        }
      },
      "auto_restart": {
        "enabled": true,
        "cooldown_sec": 300,
        "timeout_sec": 120,
        "command": "./deploy/scripts/restart-mlx.sh --timeout-sec 60"
      }
    },
    "telegram_bot": {
      "display_name": "Telegram Bot",
      "host": "ai2",
      "component": "telegram-bot",
      "tier": "crucial",
      "capabilities": ["bridge"],
      "estimated_vram_mb": 0,
      "auto_start": true,
      "auto_stop": false,
      "compose_file": "docker-compose.telegram-bot.yml",
      "health_check": "container",
      "notes": "Core Telegram bridge; readiness is based on the container running because it does not expose an HTTP ready endpoint."
    },
    "local_vllm": {
      "display_name": "vLLM Strong",
      "host": "ada2",
      "component": "vllm",
      "tier": "high",
      "capabilities": ["chat"],
      "estimated_vram_mb": 28000,
      "idle_observed_vram_mb": 27100,
      "auto_start": true,
      "auto_stop": false,
      "compose_file": "docker-compose.vllm-strong.yml",
      "ready_path": "/models",
      "notes": "Observed on ada2 with ConicCat/Magistral-Small-2509-Text-Only-FP8-Dynamic, max_model_len=2048, gpu_memory_utilization=0.68, and cpu_offload_gb=8: vLLM consumes roughly 31GB VRAM after smoke tests. System RAM gives CPU-offload/startup headroom but does not remove VRAM contention with peak media jobs."
    },
    "local_vllm_fast": {
      "display_name": "vLLM Fast",
      "host": "ai1",
      "component": "vllm-fast",
      "tier": "high",
      "capabilities": ["chat"],
      "estimated_vram_mb": 22000,
      "auto_start": true,
      "auto_stop": false,
      "compose_file": "docker-compose.vllm-fast.yml",
      "ready_path": "/models"
    },
    "local_vllm_embeddings": {
      "display_name": "vLLM Embeddings",
      "host": "meltdown",
      "component": "vllm-embeddings",
      "tier": "crucial",
      "capabilities": ["embeddings"],
      "estimated_vram_mb": 12000,
      "auto_start": true,
      "auto_stop": false,
      "compose_file": "docker-compose.vllm-embeddings.yml",
      "ready_path": "/models",
      "notes": "Assigned to meltdown's 16GB RTX 5060 Ti as the lightweight vLLM embeddings lane. Keep chat lanes on ai1/ada2 unless measurements prove they fit."
    },
    "gpu_fast": {
      "display_name": "SDXL-Turbo",
      "host": "meltdown",
      "component": "sdxl-turbo",
      "tier": "high",
      "capabilities": ["images"],
      "estimated_vram_mb": 7000,
      "auto_start": true,
      "auto_stop": true,
      "compose_file": "docker-compose.sdxl-turbo.yml",
      "ready_path": "/readyz",
      "notes": "Assigned to meltdown as the lightweight fast image lane; keep heavy InvokeAI and video generation on ada2."
    },
    "gpu_heavy": {
      "display_name": "InvokeAI Images",
      "host": "ada2",
      "components": ["invokeai", "images"],
      "tier": "optional",
      "capabilities": ["images"],
      "estimated_vram_mb": 12000,
      "auto_start": true,
      "auto_stop": true,
      "compose_files": ["docker-compose.invokeai.yml", "docker-compose.images.yml"],
      "ready_path": "/readyz",
      "notes": "InvokeAI remains the managed creative image runtime behind the OpenAI images shim. The production UI URL is advertised through INVOKEAI_UI_URL so operators can manage models in the InvokeAI interface."
    },
    "lighton_ocr": {
      "display_name": "LightOn OCR",
      "host": "ada2",
      "component": "lighton-ocr",
      "tier": "high",
      "capabilities": ["ocr"],
      "estimated_vram_mb": 7000,
      "auto_start": true,
      "auto_stop": true,
      "compose_file": "docker-compose.lighton-ocr.yml",
      "ready_path": "/readyz"
    },
    "skyreels_v2": {
      "display_name": "SkyReels V2",
      "host": "ada2",
      "component": "skyreels-v2",
      "tier": "optional",
      "capabilities": ["video"],
      "estimated_vram_mb": 18000,
      "peak_observed_vram_mb": 41000,
      "auto_start": true,
      "auto_stop": true,
      "compose_file": "docker-compose.skyreels-v2.yml",
      "ready_path": "/readyz"
    },
    "personaplex": {
      "display_name": "PersonaPlex",
      "host": "ada2",
      "component": "personaplex",
      "tier": "optional",
      "capabilities": ["speech_to_speech"],
      "estimated_vram_mb": 32000,
      "auto_start": false,
      "auto_stop": true,
      "requires_confirmation": true,
      "compose_file": "docker-compose.personaplex.yml",
      "ready_path": "/readyz",
      "notes": "CUDA/PyTorch upstream path; likely needs a reserved window on ada2 rather than coexisting with vLLM strong."
    },
    "pocket_tts": {
      "display_name": "Pocket TTS",
      "host": "ai2",
      "component": "tts",
      "tier": "high",
      "capabilities": ["tts"],
      "estimated_vram_mb": 0,
      "auto_start": true,
      "auto_stop": false,
      "compose_file": "docker-compose.tts.yml",
      "ready_path": "/readyz"
    },
    "luxtts": {
      "display_name": "LuxTTS",
      "host": "ai2",
      "component": "luxtts",
      "tier": "high",
      "capabilities": ["tts"],
      "estimated_vram_mb": 0,
      "auto_start": true,
      "auto_stop": false,
      "compose_file": "docker-compose.luxtts.yml",
      "health_timeout_sec": 30,
      "ready_path": "/readyz"
    },
    "qwen3_tts": {
      "display_name": "Qwen3 TTS",
      "host": "ai2",
      "component": "qwen3-tts",
      "tier": "optional",
      "capabilities": ["tts"],
      "estimated_vram_mb": 0,
      "auto_start": true,
      "auto_stop": true,
      "compose_file": "docker-compose.qwen3-tts.yml",
      "health_timeout_sec": 30,
      "ready_path": "/readyz"
    }
  }
}
