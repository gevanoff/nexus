        "MLX_FALLBACK_BACKEND": "local_vllm_fast",
        "MLX_FALLBACK_MODEL": "cyankiwi/Devstral-Small-2507-AWQ-4bit",
        "UI_IP_ALLOWLIST": "127.0.0.1,172.28.0.1,10.10.22.0/24",
        "TOOLS_ALLOWLIST": "echo,lighton_ocr,ltx_generate,hunyuan_video_generate,ace_step_generate,cluster_resources",
        "DISABLED_BACKEND_CLASSES": "followyourcanvas,heartmula_music,personaplex",
        "DEFAULT_BACKEND": "local_vllm"
      }
