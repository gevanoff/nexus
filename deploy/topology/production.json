{
  "schema_version": 1,
  "name": "nexus-production",
  "description": "Canonical multi-host production placement for stackrot, ai2, migraine, ada2, meltdown, and copyfail.",
  "defaults": {
    "repo_dir_by_platform": {
      "macos": "/ai-data/var/lib/nexus",
      "linux": "/home/ai/ai/nexus"
    },
    "env": {
      "VLLM_MODEL_STRONG": "ConicCat/Magistral-Small-2509-Text-Only-FP8-Dynamic",
      "VLLM_MODEL_FAST": "cyankiwi/Devstral-Small-2507-AWQ-4bit",
      "VLLM_SERVED_MODEL_NAME": "ConicCat/Magistral-Small-2509-Text-Only-FP8-Dynamic",
      "VLLM_FAST_LOAD_FORMAT": "auto",
      "VLLM_FAST_SERVED_MODEL_NAME": "cyankiwi/Devstral-Small-2507-AWQ-4bit",
      "VLLM_MODEL_DEFAULT": "ConicCat/Magistral-Small-2509-Text-Only-FP8-Dynamic",
      "VLLM_MODEL_EMBEDDINGS": "BAAI/bge-small-en-v1.5",
      "VLLM_NATIVE_TOOLS_ENABLED": "true",
      "VLLM_FAST_NATIVE_TOOLS_ENABLED": "false",
      "VLLM_ENABLE_AUTO_TOOL_CHOICE": "true",
      "VLLM_FAST_ENABLE_AUTO_TOOL_CHOICE": "false",
      "VLLM_FAST_ENFORCE_EAGER": "false",
      "VLLM_TOOL_CALL_PARSER": "xlam",
      "VLLM_FAST_TOOL_CALL_PARSER": "",
      "VLLM_CHAT_TEMPLATE": "/vllm-workspace/examples/tool_chat_template_mistral_parallel.jinja",
      "VLLM_REASONING_PARSER": "",
      "VLLM_FAST_REASONING_PARSER": "",
      "VLLM_GPU_MEMORY_UTILIZATION": "0.72",
      "VLLM_MAX_MODEL_LEN": "65536",
      "VLLM_FAST_GPU_MEMORY_UTILIZATION": "0.65",
      "VLLM_FAST_MAX_MODEL_LEN": "8192",
      "VLLM_EMBEDDINGS_GPU_MEMORY_UTILIZATION": "0.70",
      "VLLM_EMBEDDINGS_MAX_MODEL_LEN": "512",
      "MLX_MODEL_PATH": "mlx-community/GLM-5.2-4bit",
      "MLX_MODEL_TYPE": "lm",
      "MLX_MODEL_STRONG": "mlx-community/GLM-5.2-4bit",
      "MLX_MODEL_FAST": "mlx-community/Phi-4-reasoning-plus-4bit",
      "MLX_MODEL_DEFAULT": "mlx-community/GLM-5.2-4bit",
      "MLX_BASE_URL": "http://ai2:10240/v1",
      "MLX_ADVERTISE_BASE_URL": "http://ai2:10240/v1",
      "MLX_MIGRAINE_BASE_URL": "http://migraine:10241/v1",
      "VLLM_BASE_URL": "http://ada2:8003/v1",
      "VLLM_ADVERTISE_BASE_URL": "http://ada2:8003/v1",
      "VLLM_FAST_BASE_URL": "http://stackrot:8001/v1",
      "VLLM_FAST_ADVERTISE_BASE_URL": "http://stackrot:8001/v1",
      "VLLM_EMBEDDINGS_BASE_URL": "http://meltdown:8002/v1",
      "VLLM_EMBEDDINGS_ADVERTISE_BASE_URL": "http://meltdown:8002/v1",
      "VLLM_PORT": "8003",
      "IMAGES_BACKEND": "http_openai_images",
      "IMAGES_BACKEND_CLASS": "gpu_heavy",
      "IMAGES_HTTP_BASE_URL": "http://ada2:7860",
      "IMAGES_ADVERTISE_BASE_URL": "http://ada2:7860",
      "IMAGES_SHIM_INVOKEAI_BASE_URL": "http://invokeai:9090",
      "INVOKEAI_BASE_URL": "http://ada2:9090",
      "INVOKEAI_ADVERTISE_BASE_URL": "http://ada2:9090",
      "INVOKEAI_UI_URL": "http://ada2:9090",
      "SDXL_TURBO_BASE_URL": "http://meltdown:9050",
      "SDXL_TURBO_ADVERTISE_BASE_URL": "http://meltdown:9050",
      "LIGHTON_OCR_API_BASE_URL": "http://ada2:9155",
      "LIGHTON_OCR_ADVERTISE_BASE_URL": "http://ada2:9155",
      "PERSONAPLEX_BASE_URL": "http://ada2:9160",
      "PERSONAPLEX_ADVERTISE_BASE_URL": "http://ada2:9160",
      "SKYREELS_V2_BASE_URL": "http://ada2:9180",
      "SKYREELS_V2_ADVERTISE_BASE_URL": "http://ada2:9180",
      "POCKET_TTS_BASE_URL": "http://stackrot:9940",
      "POCKET_TTS_ADVERTISE_BASE_URL": "http://stackrot:9940",
      "LUXTTS_BASE_URL": "http://stackrot:9170",
      "LUXTTS_ADVERTISE_BASE_URL": "http://stackrot:9170",
      "QWEN3_TTS_BASE_URL": "http://stackrot:9175",
      "QWEN3_TTS_ADVERTISE_BASE_URL": "http://stackrot:9175",
      "MEDIAMTX_HLS_PORT": "8891",
      "MEDIAMTX_ADVERTISE_BASE_URL": "http://stackrot:8891",
      "MEDIAMTX_API_ADVERTISE_URL": "http://stackrot:9997",
      "MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS": "stackrot",
      "DEFAULT_BACKEND": "local_vllm",
      "EMBEDDINGS_BACKEND": "local_mlx",
      "EMBEDDINGS_MODEL": "mlx-community/bge-small-en-v1.5-8bit",
      "TRANSCRIPTION_BACKEND_CLASS": "local_mlx",
      "ROUTER_ENABLE_POLICY": "true",
      "ETCD_PREFIX": "/nexus/services/",
      "NEXUS_REGISTRATION_INTERVAL_SEC": "30",
      "NEXUS_REGISTRATION_TIMEOUT_SEC": "5",
      "NEXUS_REGISTRATION_LEASE_TTL_SEC": "90",
      "LIFECYCLE_MANAGER_BASE_URL": "http://lifecycle-manager:9190",
      "LIFECYCLE_MANAGER_ADVERTISE_BASE_URL": "http://ai2:9190",
      "NEXUS_LIFECYCLE_MODE": "assisted",
      "TELEGRAM_REQUIRE_MENTION": "true",
      "TELEGRAM_MENTION_PATTERNS": "Nexus",
      "NEXUS_TOOL_EXECUTION_DEFAULT": "client_exec",
      "NEXUS_AUTO_INJECT_TOOLS": "true",
      "NEXUS_AUTO_INJECT_TOOLSETS": "core,repo,ops",
      "NEXUS_UI_GATEWAY_EXEC": "false"
    }
  },
  "hosts": {
    "stackrot": {
      "description": "Dual-GPU Linux/NVIDIA node (2x RTX 3090 24GB) for media ingress, TTS, and secondary vLLM/CUDA capacity.",
      "platform": "linux",
      "resource_kind": "linux_nvidia",
      "ssh_target": "ai@stackrot",
      "components": [
        "mediamtx",
        "vllm-fast",
        "tts",
        "luxtts",
        "qwen3-tts"
      ],
      "env": {
        "ETCD_URL": "http://ai2:2379",
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
        "VLLM_FAST_SERVICE_NAME": "vllm-fast",
        "VLLM_FAST_BACKEND_CLASS": "local_vllm_fast",
        "VLLM_FAST_TOKENIZER": "cyankiwi/Devstral-Small-2507-AWQ-4bit",
        "VLLM_FAST_TOKENIZER_MODE": "mistral",
        "VLLM_FAST_CONFIG_FORMAT": "hf",
        "VLLM_FAST_GPU_MEMORY_UTILIZATION": "0.82",
        "VLLM_FAST_MAX_MODEL_LEN": "8192",
        "VLLM_FAST_CUDA_VISIBLE_DEVICES": "0",
        "LUXTTS_UPSTREAM_BASE_URL": "http://qwen3-tts:9175",
        "LUXTTS_PROMPT_AUDIO": "/var/lib/tts_refs/Gabriel4_dbf8a412dcaf.wav",
        "QWEN3_TTS_CUDA_VISIBLE_DEVICES": "1",
        "QWEN3_TTS_DEVICE_MAP": "cuda:0",
        "QWEN3_TTS_DTYPE": "float16",
        "QWEN3_TTS_ATTN_IMPL": "sdpa"
      }
    },
    "ai2": {
      "description": "Mac M3 Ultra with 512GB unified memory for gateway/control plane and host-native MLX reasoning.",
      "platform": "macos",
      "resource_kind": "macos",
      "remote_shell": "/bin/bash -lc",
      "ssh_target": "ai@ai2",
      "components": [
        "gateway",
        "etcd",
        "lifecycle-manager",
        "telegram-bot"
      ],
      "native_services": [
        "mlx"
      ],
      "env": {
        "ETCD_URL": "http://etcd:2379",
        "NEXUS_TOPOLOGY_HOST_DIR": "/Volumes/ai_data/var/lib/nexus/deploy/topology",
        "MLX_BASE_URL": "http://ai2:10240/v1",
        "MLX_ADVERTISE_BASE_URL": "http://ai2:10240/v1",
        "VLLM_BASE_URL": "http://host.docker.internal:18003/v1",
        "VLLM_FAST_BASE_URL": "http://host.docker.internal:18001/v1",
        "VLLM_EMBEDDINGS_BASE_URL": "http://host.docker.internal:18002/v1",
        "IMAGES_HTTP_BASE_URL": "http://host.docker.internal:17860",
        "IMAGES_ADVERTISE_BASE_URL": "http://host.docker.internal:17860",
        "SDXL_TURBO_BASE_URL": "http://host.docker.internal:18050",
        "SDXL_TURBO_ADVERTISE_BASE_URL": "http://host.docker.internal:18050",
        "LIGHTON_OCR_API_BASE_URL": "http://host.docker.internal:18155",
        "LIGHTON_OCR_ADVERTISE_BASE_URL": "http://host.docker.internal:18155",
        "PERSONAPLEX_BASE_URL": "http://host.docker.internal:18160",
        "PERSONAPLEX_ADVERTISE_BASE_URL": "http://host.docker.internal:18160",
        "SKYREELS_V2_BASE_URL": "http://host.docker.internal:18180",
        "SKYREELS_V2_ADVERTISE_BASE_URL": "http://host.docker.internal:18180",
        "BACKEND_ENV_BASE_URL_OVERRIDES": "local_vllm,local_vllm_fast,local_vllm_embeddings,gpu_heavy,gpu_fast,lighton_ocr,personaplex,skyreels_v2",
        "MLX_FALLBACK_BACKEND": "local_vllm_fast",
        "MLX_FALLBACK_MODEL": "cyankiwi/Devstral-Small-2507-AWQ-4bit",
        "UI_IP_ALLOWLIST": "127.0.0.1,172.28.0.1,10.10.22.0/24",
        "TOOLS_ALLOWLIST": "echo,lighton_ocr,skyreels_generate,cluster_resources",
        "DISABLED_BACKEND_CLASSES": "followyourcanvas,heartmula_music,personaplex",
        "DEFAULT_BACKEND": "local_vllm"
      }
    },
    "migraine": {
      "description": "Mac M2 with 8GB unified memory for Hermes and a memory-bounded native MLX chat model.",
      "platform": "macos",
      "resource_kind": "macos",
      "repo_dir": "/Users/ai/ai/nexus",
      "remote_shell": "/bin/bash -lc",
      "ssh_target": "ai@migraine",
      "components": [],
      "native_services": [
        "mlx"
      ],
      "env": {
        "ETCD_URL": "http://ai2:2379",
        "MLX_MIGRAINE_BASE_URL": "http://migraine:10241/v1",
        "MLX_PORT": "10241",
        "MLX_MODEL_PATH": "mlx-community/Llama-3.2-3B-Instruct-4bit",
        "MLX_MODEL_TYPE": "lm",
        "MLX_SERVER_IMPL": "mlx_lm",
        "MLX_DECODE_CONCURRENCY": "1",
        "MLX_PROMPT_CONCURRENCY": "1",
        "MLX_PROMPT_CACHE_SIZE": "1",
        "MLX_MAX_TOKENS": "768"
      }
    },
    "ada2": {
      "description": "Linux/NVIDIA node with 128GB system RAM and an RTX 6000 Ada 48GB for primary heavy vLLM plus image and video generation services.",
      "platform": "linux",
      "resource_kind": "linux_nvidia",
      "ssh_target": "ai@ada2",
      "components": [
        "images",
        "invokeai",
        "lighton-ocr",
        "skyreels-v2",
        "vllm-strong"
      ],
      "env": {
        "ETCD_URL": "http://ai2:2379",
        "IMAGES_SHIM_MODE": "invokeai_queue",
        "SDXL_TURBO_ENABLE_MODEL_CPU_OFFLOAD": "true",
        "SDXL_TURBO_MAX_GUIDANCE_SCALE": "0.0",
        "VLLM_SERVICE_NAME": "vllm",
        "VLLM_BACKEND_CLASS": "local_vllm",
        "VLLM_CONFIG_FORMAT": "hf",
        "VLLM_CPU_OFFLOAD_GB": "8",
        "VLLM_GPU_MEMORY_UTILIZATION": "0.68",
        "VLLM_MAX_MODEL_LEN": "65536"
      }
    },
    "meltdown": {
      "description": "Ubuntu 22.04 Linux/NVIDIA node with Intel Core i7-5930K, about 47 GiB system RAM, and a GeForce RTX 5060 Ti 16GB for lighter CUDA overflow and staging.",
      "platform": "linux",
      "resource_kind": "linux_nvidia",
      "ssh_target": "ai@meltdown",
      "components": [
        "sdxl-turbo",
        "vllm-embeddings"
      ],
      "env": {
        "ETCD_URL": "http://ai2:2379",
        "SDXL_TURBO_DEVICE": "cuda",
        "SDXL_TURBO_CUDA_VISIBLE_DEVICES": "0",
        "SDXL_TURBO_ENABLE_MODEL_CPU_OFFLOAD": "true",
        "SDXL_TURBO_ENABLE_SEQUENTIAL_CPU_OFFLOAD": "true",
        "SDXL_TURBO_MAX_GUIDANCE_SCALE": "0.0",
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
        "VLLM_EMBEDDINGS_SERVICE_NAME": "vllm-embeddings",
        "VLLM_EMBEDDINGS_BACKEND_CLASS": "local_vllm_embeddings",
        "VLLM_EMBEDDINGS_GPU_MEMORY_UTILIZATION": "0.70",
        "VLLM_EMBEDDINGS_MAX_MODEL_LEN": "512",
        "VLLM_EMBEDDINGS_CUDA_VISIBLE_DEVICES": "0"
      }
    },
    "copyfail": {
      "description": "Ubuntu 22.04 infrastructure-only host with Intel Celeron J3355, 2 logical CPUs, and about 7.4 GiB system RAM. Use for metrics collection, deployment orchestration, and general IT infrastructure; do not schedule model-serving backends here.",
      "platform": "linux",
      "resource_kind": "linux_infra",
      "ssh_target": "ai@copyfail",
      "components": [],
      "roles": [
        "deployment_control",
        "metrics_collection",
        "it_infrastructure"
      ],
      "env": {
        "ETCD_URL": "http://ai2:2379"
      }
    }
  }
}
