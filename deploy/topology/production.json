  "hosts": {
    "stackrot": {
      "description": "Dual-GPU Linux/NVIDIA node (2x RTX 3090 24GB) for media ingress, TTS, music/video generation, and secondary vLLM capacity.",
      "platform": "linux",
      "resource_kind": "linux_nvidia",
      "ssh_target": "ai@stackrot",
      "components": [
        "mediamtx",
        "vllm-fast",
        "tts",
        "luxtts",
        "qwen3-tts"
      ],
      "optional_components": [
        "hunyuan-video",
        "ace-step"
      ],
      "env": {
        "ETCD_URL": "http://ai2:2379",
        "NEXUS_RUNTIME_ROOT": "./.runtime",
        "HF_HOME": "/var/lib/huggingface",
        "HF_HOME_BIND_SOURCE": "/var/lib/huggingface",
        "HUNYUAN_VIDEO_CUDA_VISIBLE_DEVICES": "1",
        "ACE_STEP_CUDA_VISIBLE_DEVICES": "1",
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
        "VLLM_FAST_SERVICE_NAME": "vllm-fast",
        "VLLM_FAST_BACKEND_CLASS": "local_vllm_fast",
        "VLLM_FAST_TOKENIZER": "cyankiwi/Devstral-Small-2507-AWQ-4bit",
